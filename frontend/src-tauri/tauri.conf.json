{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Evidence Lane",
  "version": "0.1.1",
  "identifier": "com.evidenceos.clean.sqlitebuilder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1430",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Evidence Lane - SQLite Builder",
        "width": 1620,
        "height": 940,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
