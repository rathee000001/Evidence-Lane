UEPC_ENV_VERSION=V15
PACKAGE_CLASS=UEPC_ENV15_PUBLIC_FULL_LOCKED_RUNTIME
ENV_SQLITE=env/env_sqlite.sqlite
ENV_LAW=env/env_law.md
ENV_MMD=env/env_mmd.mmd
ENV_MMD_SVG=env/env_mmd.svg
ENV_MMD_PNG=env/env_mmd.png
ENV_PUBLIC_READ=true
ENV_NORMAL_TURN_WRITE=false
ENV_DEFAULT_OPEN_MODE=mode=ro&immutable=1
ENV_MUTATION_ALLOWED_ONLY_IN_MODE=flash_env
PROFILE_POINTER=.uepc_profile
PROJECT_POINTER=.uepc_project
PROJECT_ROUTER=project/project_router.sqlite
CHAT_LINEAGE_POINTER=project/sectors/chat_lineage/chat_lineage_pointer.json
CHAT_LINEAGE_AUTO_APPEND_DEFAULT=true
WRITEBACK_POLICY_DEFAULT=AUTO
READ_ONLY_AUDIT_POLICY=DISABLED_READ_ONLY_AUDIT
VERSION_CONTROL_POLICY=IMMUTABLE_HASHED_SNAPSHOTS
LAST_EXIT_RECEIPT=receipts/last_exit_slip.txt
NEXT_EXPECTED_INDEX=ENV15.FECDO.P15.S00.T002
